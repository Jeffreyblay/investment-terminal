# Copy to .env and edit. All services below are free.

# REQUIRED by the SEC: identify yourself (name + email). Requests without it get blocked.
SEC_USER_AGENT="Jeffrey Blay your-email@example.com"

# Max requests per second to SEC (their limit is 10; stay below it)
SEC_MAX_RPS=8

# Local LLM served by Ollama (https://ollama.com). Free, runs on your machine.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Where everything is cached and stored
DATA_DIR=./data

# Optional: Neo4j Community Edition (free, GPLv3). Leave blank to use SQLite only.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
